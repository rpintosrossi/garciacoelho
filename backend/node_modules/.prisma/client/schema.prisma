generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  role          Role           @default(OPERADOR)
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serviceDrafts ServiceDraft[]
}

model Administrator {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  phone         String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  emailNames    String[]
  emails        String[]
  phoneNames    String[]
  phones        String[]
  officeAddress String?
  buildings     Building[]

  @@index([email])
  @@index([name])
}

model Building {
  id              String         @id @default(uuid())
  name            String
  address         String
  cuit            String         @unique
  contact         String
  taxCondition    TaxCondition   @default(CONSUMIDOR_FINAL)
  administratorId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  apartments      Int?
  debtThreshold   Int            @default(30)
  doormanType     String?
  floors          Int?
  generalInfo     String?
  locality        String?
  managerPhone    String?
  phones          String[]
  rating          Int            @default(1)
  phoneNames      String[]
  account         Account?
  administrator   Administrator  @relation(fields: [administratorId], references: [id])
  services        Service[]
  serviceDrafts   ServiceDraft[]

  @@index([administratorId])
  @@index([name])
  @@index([locality])
  @@index([administratorId, name])
}

model Service {
  id                 String        @id @default(uuid())
  description        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  buildingId         String
  name               String
  technicianId       String?
  visitDate          DateTime?
  status             ServiceStatus @default(PENDIENTE)
  receiptImages      String[]
  cancellationReason String?
  invoiceId          String?
  remitos            Remito[]
  building           Building      @relation(fields: [buildingId], references: [id])
  technician         Technician?   @relation(fields: [technicianId], references: [id])
  invoice            Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([buildingId])
  @@index([buildingId, status])
  @@index([buildingId, status, createdAt], map: "Service_building_status_created_idx")
  @@index([createdAt])
  @@index([status])
  @@index([technicianId])
  @@index([invoiceId])
}

model Invoice {
  id               String            @id @default(uuid())
  amount           Float
  status           InvoiceStatus     @default(PENDIENTE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  date             DateTime?
  fileUrl          String?
  number           String?
  paymentMethod    String?
  services         Service[]
  paymentDocuments PaymentDocument[]

  @@index([createdAt])
  @@index([paymentMethod])
  @@index([paymentMethod, status], map: "Invoice_payment_status_idx")
  @@index([status])
}

model Account {
  id         String   @id @default(uuid())
  balance    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  buildingId String   @unique
  building   Building @relation(fields: [buildingId], references: [id])

  @@index([buildingId])
}

model ServiceDraft {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  status      String
  buildingId  String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  building    Building @relation(fields: [buildingId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("service_drafts")
}

model Technician {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]

  @@map("technicians")
}

model Payment {
  id              String            @id @default(uuid())
  amount          Float
  date            DateTime
  method          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  paymentMethodId String?
  comprobante     String            @unique
  discount        Float             @default(0)
  discountReason  String?
  originalAmount  Float?
  paymentMethod   PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  documents       PaymentDocument[]

  @@index([createdAt])
  @@index([date])
  @@index([method])
  @@index([paymentMethodId])
}

model PaymentDocument {
  id        String   @id @default(uuid())
  paymentId String
  invoiceId String?
  remitoId  String?
  amount    Float
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  payment   Payment  @relation(fields: [paymentId], references: [id])
  remito    Remito?  @relation(fields: [remitoId], references: [id])

  @@index([invoiceId, amount])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([remitoId])
}

model PaymentMethod {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  alias     String?
  banco     String?
  cbu       String?
  cuenta    String?
  cuit      String?
  titular   String?
  payments  Payment[]
}

model Remito {
  id               String            @id @default(uuid())
  serviceId        String
  number           String
  amount           Float
  date             DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  receiptImages    String[]
  paymentDocuments PaymentDocument[]
  service          Service           @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, number])
  @@index([createdAt])
  @@index([date])
  @@index([serviceId])
  @@index([serviceId, number])
}

model Zone {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  localities  ZoneLocality[]
}

model Locality {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model ZoneLocality {
  id        String   @id @default(uuid())
  zoneId    String
  locality  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, locality])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  color       String   @default("#2196f3")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Stock       Stock[]

  @@index([name])
}

model Stock {
  id          String   @id
  name        String
  description String
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  unit        String
  price       Float    @default(0)
  supplier    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  categoryId  String
  Category    Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([name])
}

enum Role {
  ADMIN
  OPERADOR
  TECNICO
}

enum ServiceStatus {
  PENDIENTE
  ASIGNADO
  CON_REMITO
  FACTURADO
}

enum InvoiceStatus {
  PENDIENTE
  EMITIDA
  PAGADA
}

enum TaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}
